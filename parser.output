Grammar

    0 $accept: program $end

    1 program: translation_unit

    2 translation_unit: external_declaration
    3                 | translation_unit external_declaration

    4 external_declaration: function_definition
    5                     | declaration
    6                     | expression_statement

    7 function_definition: declaration_specifiers declarator compound_statement

    8 primary_expression: IDENTIFIER
    9                   | qualified_id
   10                   | CONSTANT
   11                   | STRING_LITERAL
   12                   | CHAR_LITERAL
   13                   | BOOL_TRUE
   14                   | BOOL_FALSE
   15                   | '(' expression ')'
   16                   | lambda_expression

   17 postfix_expression: primary_expression
   18                   | postfix_expression '[' expression ']'
   19                   | postfix_expression '(' ')'
   20                   | postfix_expression '(' argument_expression_list ')'
   21                   | postfix_expression '.' IDENTIFIER
   22                   | postfix_expression PTR_OP IDENTIFIER
   23                   | postfix_expression INC_OP
   24                   | postfix_expression DEC_OP

   25 argument_expression_list: assignment_expression
   26                         | argument_expression_list ',' assignment_expression

   27 unary_expression: postfix_expression
   28                 | INC_OP unary_expression
   29                 | DEC_OP unary_expression
   30                 | '&' cast_expression
   31                 | '*' cast_expression
   32                 | '+' cast_expression
   33                 | '-' cast_expression
   34                 | '~' cast_expression
   35                 | '!' cast_expression
   36                 | SIZEOF unary_expression
   37                 | SIZEOF '(' type_name ')'
   38                 | new_expression
   39                 | delete_expression

   40 cast_expression: unary_expression
   41                | '(' type_name ')' cast_expression

   42 multiplicative_expression: cast_expression
   43                          | multiplicative_expression '*' cast_expression
   44                          | multiplicative_expression '/' cast_expression
   45                          | multiplicative_expression '%' cast_expression

   46 additive_expression: multiplicative_expression
   47                    | additive_expression '+' multiplicative_expression
   48                    | additive_expression '-' multiplicative_expression

   49 shift_expression: additive_expression
   50                 | shift_expression LSHIFT_OP additive_expression
   51                 | shift_expression RSHIFT_OP additive_expression

   52 relational_expression: shift_expression
   53                      | relational_expression '<' shift_expression
   54                      | relational_expression '>' shift_expression
   55                      | relational_expression LE_OP shift_expression
   56                      | relational_expression GE_OP shift_expression

   57 equality_expression: relational_expression
   58                    | equality_expression EQ_OP relational_expression
   59                    | equality_expression NE_OP relational_expression

   60 and_expression: equality_expression
   61               | and_expression '&' equality_expression

   62 exclusive_or_expression: and_expression
   63                        | exclusive_or_expression '^' and_expression

   64 inclusive_or_expression: exclusive_or_expression
   65                        | inclusive_or_expression '|' exclusive_or_expression

   66 logical_and_expression: inclusive_or_expression
   67                       | logical_and_expression LAND_OP inclusive_or_expression

   68 logical_or_expression: logical_and_expression
   69                      | logical_or_expression LOR_OP logical_and_expression

   70 conditional_expression: logical_or_expression
   71                       | logical_or_expression '?' expression ':' conditional_expression

   72 assignment_expression: conditional_expression
   73                      | unary_expression assignment_operator assignment_expression

   74 assignment_operator: '='
   75                    | MUL_ASSIGN
   76                    | DIV_ASSIGN
   77                    | MOD_ASSIGN
   78                    | ADD_ASSIGN
   79                    | SUB_ASSIGN
   80                    | LSHIFT_ASSIGN
   81                    | RSHIFT_ASSIGN
   82                    | AND_ASSIGN
   83                    | XOR_ASSIGN
   84                    | OR_ASSIGN

   85 expression: assignment_expression
   86           | expression ',' assignment_expression

   87 constant_expression: conditional_expression

   88 new_expression: NEW type_name '(' ')'
   89               | NEW type_name
   90               | NEW type_name initializer
   91               | SCOPE_OP NEW type_name '(' ')'
   92               | SCOPE_OP NEW type_name
   93               | SCOPE_OP NEW type_name initializer

   94 delete_expression: DELETE cast_expression
   95                  | SCOPE_OP DELETE cast_expression

   96 lambda_expression: '[' ']' '(' parameter_type_list ')' compound_statement
   97                  | '[' ']' '(' ')' compound_statement

   98 statement: labeled_statement
   99          | compound_statement
  100          | expression_statement
  101          | selection_statement
  102          | iteration_statement
  103          | jump_statement

  104 labeled_statement: IDENTIFIER ':' statement
  105                  | CASE constant_expression ':' statement
  106                  | DEFAULT ':' statement

  107 compound_statement: '{' '}'
  108                   | '{' block_item_list '}'

  109 block_item_list: block_item
  110                | block_item_list block_item

  111 block_item: declaration
  112           | statement

  113 expression_statement: ';'
  114                     | expression ';'

  115 selection_statement: IF '(' expression ')' statement
  116                    | IF '(' expression ')' statement ELSE statement
  117                    | SWITCH '(' expression ')' statement

  118 iteration_statement: WHILE '(' expression ')' statement
  119                    | UNTIL '(' expression ')' statement
  120                    | DO statement WHILE '(' expression ')' ';'
  121                    | FOR '(' expression_statement expression_statement ')' statement
  122                    | FOR '(' expression_statement expression_statement expression ')' statement
  123                    | FOR '(' declaration expression_statement ')' statement
  124                    | FOR '(' declaration expression_statement expression ')' statement

  125 jump_statement: GOTO IDENTIFIER ';'
  126               | CONTINUE ';'
  127               | BREAK ';'
  128               | RETURN ';'
  129               | RETURN expression ';'

  130 declaration: declaration_specifiers ';'
  131            | declaration_specifiers init_declarator_list ';'
  132            | CLASS IDENTIFIER ';'

  133 declaration_specifiers: declaration_specifier
  134                       | declaration_specifiers declaration_specifier

  135 declaration_specifier: storage_class_specifier
  136                      | type_specifier
  137                      | type_qualifier
  138                      | FRIEND

  139 init_declarator_list: init_declarator
  140                     | init_declarator_list ',' init_declarator

  141 init_declarator: declarator
  142                | declarator '=' initializer

  143 storage_class_specifier: TYPEDEF
  144                        | EXTERN
  145                        | STATIC
  146                        | AUTO
  147                        | REGISTER

  148 type_specifier: VOID
  149               | CHAR
  150               | SHORT
  151               | INT
  152               | LONG
  153               | FLOAT
  154               | DOUBLE
  155               | SIGNED
  156               | UNSIGNED
  157               | BOOL
  158               | STRING
  159               | FILE_TYPE
  160               | struct_or_union_specifier
  161               | enum_specifier
  162               | class_specifier
  163               | TYPE_NAME

  164 type_qualifier: CONST
  165               | VOLATILE

  166 struct_or_union_specifier: STRUCT IDENTIFIER '{' struct_declaration_list '}'
  167                          | UNION IDENTIFIER '{' struct_declaration_list '}'
  168                          | STRUCT '{' struct_declaration_list '}'
  169                          | UNION '{' struct_declaration_list '}'
  170                          | STRUCT TYPE_NAME
  171                          | UNION TYPE_NAME

  172 struct_declaration_list: struct_declaration
  173                        | struct_declaration_list struct_declaration

  174 struct_declaration: declaration_specifiers struct_declarator_list ';'

  175 struct_declarator_list: struct_declarator
  176                       | struct_declarator_list ',' struct_declarator

  177 struct_declarator: declarator
  178                  | declarator ':' constant_expression

  179 enum_specifier: ENUM '{' enumerator_list '}'
  180               | ENUM IDENTIFIER '{' enumerator_list '}'
  181               | ENUM TYPE_NAME

  182 enumerator_list: enumerator
  183                | enumerator_list ',' enumerator

  184 enumerator: IDENTIFIER
  185           | IDENTIFIER '=' constant_expression

  186 class_specifier: CLASS class_name base_clause '{' class_member_list '}'

  187 class_name: IDENTIFIER
  188           | TYPE_NAME

  189 base_clause: /* empty */
  190            | ':' base_specifier
  191            | base_clause ',' base_specifier

  192 base_specifier: access_specifier class_name
  193               | class_name

  194 access_specifier: PUBLIC
  195                 | PRIVATE
  196                 | PROTECTED

  197 class_member_list: /* empty */
  198                  | class_member_list class_member

  199 class_member: declaration
  200             | function_definition
  201             | access_specifier ':'

  202 nested_name_specifier: IDENTIFIER SCOPE_OP
  203                      | TYPE_NAME SCOPE_OP
  204                      | nested_name_specifier IDENTIFIER SCOPE_OP
  205                      | nested_name_specifier TYPE_NAME SCOPE_OP

  206 qualified_id: nested_name_specifier IDENTIFIER
  207             | nested_name_specifier TYPE_NAME

  208 declarator: ptr_operator declarator
  209           | direct_declarator

  210 direct_declarator: IDENTIFIER
  211                  | qualified_id
  212                  | '(' declarator ')'
  213                  | direct_declarator '[' constant_expression ']'
  214                  | direct_declarator '[' ']'
  215                  | direct_declarator '(' parameter_type_list ')'
  216                  | direct_declarator '(' ')'

  217 ptr_operator: '*' type_qualifier_list_opt
  218             | '&' type_qualifier_list_opt

  219 type_qualifier_list_opt: /* empty */
  220                        | type_qualifier_list

  221 type_qualifier_list: type_qualifier
  222                    | type_qualifier_list type_qualifier

  223 parameter_type_list: parameter_list
  224                    | parameter_list ',' ELLIPSIS

  225 parameter_list: parameter_declaration
  226               | parameter_list ',' parameter_declaration

  227 parameter_declaration: declaration_specifiers declarator
  228                      | declaration_specifiers abstract_declarator
  229                      | declaration_specifiers

  230 type_name: declaration_specifiers abstract_declarator
  231          | declaration_specifiers

  232 abstract_declarator: ptr_operator
  233                    | ptr_operator direct_abstract_declarator
  234                    | direct_abstract_declarator

  235 direct_abstract_declarator: '(' abstract_declarator ')'
  236                           | '[' ']'
  237                           | '[' constant_expression ']'
  238                           | direct_abstract_declarator '[' ']'
  239                           | direct_abstract_declarator '[' constant_expression ']'
  240                           | '(' ')'
  241                           | '(' parameter_type_list ')'
  242                           | direct_abstract_declarator '(' ')'
  243                           | direct_abstract_declarator '(' parameter_type_list ')'

  244 initializer: assignment_expression
  245            | '{' initializer_list '}'
  246            | '{' initializer_list ',' '}'

  247 initializer_list: initializer
  248                 | initializer_list ',' initializer



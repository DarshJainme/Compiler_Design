Grammar

    0 $accept: program $end

    1 program: translation_unit

    2 translation_unit: external_declaration
    3                 | translation_unit external_declaration

    4 external_declaration: function_definition
    5                     | declaration
    6                     | expression_statement
    7                     | ';'

    8 function_definition: declaration_specifiers declarator compound_statement

    9 primary_expression: IDENTIFIER
   10                   | CONSTANT
   11                   | STRING_LITERAL
   12                   | CHAR_LITERAL
   13                   | BOOL_TRUE
   14                   | BOOL_FALSE
   15                   | '(' expression ')'
   16                   | lambda_expression

   17 postfix_expression: primary_expression
   18                   | postfix_expression '[' expression ']'
   19                   | postfix_expression '(' ')'
   20                   | postfix_expression '(' argument_expression_list ')'
   21                   | postfix_expression '.' IDENTIFIER
   22                   | postfix_expression PTR_OP IDENTIFIER
   23                   | postfix_expression INC_OP
   24                   | postfix_expression DEC_OP

   25 argument_expression_list: assignment_expression
   26                         | argument_expression_list ',' assignment_expression

   27 unary_expression: postfix_expression
   28                 | INC_OP unary_expression
   29                 | DEC_OP unary_expression
   30                 | '&' cast_expression
   31                 | '*' cast_expression
   32                 | '+' cast_expression
   33                 | '-' cast_expression
   34                 | '~' cast_expression
   35                 | '!' cast_expression
   36                 | SIZEOF unary_expression
   37                 | SIZEOF '(' type_name ')'
   38                 | new_expression
   39                 | delete_expression

   40 cast_expression: unary_expression
   41                | '(' type_name ')' cast_expression

   42 multiplicative_expression: cast_expression
   43                          | multiplicative_expression '*' cast_expression
   44                          | multiplicative_expression '/' cast_expression
   45                          | multiplicative_expression '%' cast_expression

   46 additive_expression: multiplicative_expression
   47                    | additive_expression '+' multiplicative_expression
   48                    | additive_expression '-' multiplicative_expression

   49 shift_expression: additive_expression
   50                 | shift_expression LSHIFT_OP additive_expression
   51                 | shift_expression RSHIFT_OP additive_expression

   52 relational_expression: shift_expression
   53                      | relational_expression '<' shift_expression
   54                      | relational_expression '>' shift_expression
   55                      | relational_expression LE_OP shift_expression
   56                      | relational_expression GE_OP shift_expression

   57 equality_expression: relational_expression
   58                    | equality_expression EQ_OP relational_expression
   59                    | equality_expression NE_OP relational_expression

   60 and_expression: equality_expression
   61               | and_expression '&' equality_expression

   62 exclusive_or_expression: and_expression
   63                        | exclusive_or_expression '^' and_expression

   64 inclusive_or_expression: exclusive_or_expression
   65                        | inclusive_or_expression '|' exclusive_or_expression

   66 logical_and_expression: inclusive_or_expression
   67                       | logical_and_expression LAND_OP inclusive_or_expression

   68 logical_or_expression: logical_and_expression
   69                      | logical_or_expression LOR_OP logical_and_expression

   70 conditional_expression: logical_or_expression
   71                       | logical_or_expression '?' expression ':' conditional_expression

   72 assignment_expression: conditional_expression
   73                      | unary_expression assignment_operator assignment_expression

   74 assignment_operator: '='
   75                    | MUL_ASSIGN
   76                    | DIV_ASSIGN
   77                    | MOD_ASSIGN
   78                    | ADD_ASSIGN
   79                    | SUB_ASSIGN
   80                    | LSHIFT_ASSIGN
   81                    | RSHIFT_ASSIGN
   82                    | AND_ASSIGN
   83                    | XOR_ASSIGN
   84                    | OR_ASSIGN

   85 expression: assignment_expression
   86           | expression ',' assignment_expression

   87 constant_expression: conditional_expression

   88 new_expression: NEW type_name '(' ')'
   89               | NEW type_name
   90               | NEW type_name initializer

   91 delete_expression: DELETE cast_expression

   92 lambda_expression: '[' ']' '(' parameter_type_list ')' compound_statement
   93                  | '[' ']' '(' ')' compound_statement

   94 statement: labeled_statement
   95          | compound_statement
   96          | expression_statement
   97          | selection_statement
   98          | iteration_statement
   99          | jump_statement

  100 labeled_statement: IDENTIFIER ':' statement
  101                  | CASE constant_expression ':' statement
  102                  | DEFAULT ':' statement

  103 compound_statement: '{' '}'
  104                   | '{' block_item_list '}'

  105 block_item_list: block_item
  106                | block_item_list block_item

  107 block_item: declaration
  108           | statement

  109 expression_statement: ';'
  110                     | expression ';'

  111 selection_statement: IF '(' expression ')' statement
  112                    | IF '(' expression ')' statement ELSE statement
  113                    | SWITCH '(' expression ')' statement

  114 iteration_statement: WHILE '(' expression ')' statement
  115                    | DO statement WHILE '(' expression ')' ';'
  116                    | FOR '(' expression_statement expression_statement ')' statement
  117                    | FOR '(' expression_statement expression_statement expression ')' statement
  118                    | FOR '(' declaration expression_statement ')' statement
  119                    | FOR '(' declaration expression_statement expression ')' statement

  120 jump_statement: GOTO IDENTIFIER ';'
  121               | CONTINUE ';'
  122               | BREAK ';'
  123               | RETURN ';'
  124               | RETURN expression ';'

  125 declaration: declaration_specifiers ';'
  126            | declaration_specifiers init_declarator_list ';'

  127 declaration_specifiers: declaration_specifier
  128                       | declaration_specifiers declaration_specifier

  129 declaration_specifier: storage_class_specifier
  130                      | type_specifier
  131                      | type_qualifier

  132 init_declarator_list: init_declarator
  133                     | init_declarator_list ',' init_declarator

  134 init_declarator: declarator
  135                | declarator '=' initializer

  136 storage_class_specifier: TYPEDEF
  137                        | EXTERN
  138                        | STATIC
  139                        | AUTO
  140                        | REGISTER

  141 type_specifier: VOID
  142               | CHAR
  143               | SHORT
  144               | INT
  145               | LONG
  146               | FLOAT
  147               | DOUBLE
  148               | SIGNED
  149               | UNSIGNED
  150               | BOOL
  151               | STRING
  152               | FILE_TYPE
  153               | struct_or_union_specifier
  154               | enum_specifier
  155               | class_specifier
  156               | TYPE_NAME

  157 type_qualifier: CONST
  158               | VOLATILE

  159 struct_or_union_specifier: STRUCT IDENTIFIER '{' struct_declaration_list '}'
  160                          | UNION IDENTIFIER '{' struct_declaration_list '}'
  161                          | STRUCT '{' struct_declaration_list '}'
  162                          | UNION '{' struct_declaration_list '}'
  163                          | STRUCT TYPE_NAME
  164                          | UNION TYPE_NAME

  165 struct_declaration_list: struct_declaration
  166                        | struct_declaration_list struct_declaration

  167 struct_declaration: declaration_specifiers struct_declarator_list ';'

  168 struct_declarator_list: struct_declarator
  169                       | struct_declarator_list ',' struct_declarator

  170 struct_declarator: declarator
  171                  | declarator ':' constant_expression

  172 enum_specifier: ENUM '{' enumerator_list '}'
  173               | ENUM IDENTIFIER '{' enumerator_list '}'
  174               | ENUM TYPE_NAME

  175 enumerator_list: enumerator
  176                | enumerator_list ',' enumerator

  177 enumerator: IDENTIFIER
  178           | IDENTIFIER '=' constant_expression

  179 class_specifier: CLASS class_name base_clause '{' class_member_list '}'

  180 class_name: IDENTIFIER
  181           | TYPE_NAME

  182 base_clause: /* empty */
  183            | ':' base_specifier
  184            | base_clause ',' base_specifier

  185 base_specifier: access_specifier class_name
  186               | class_name

  187 access_specifier: PUBLIC
  188                 | PRIVATE
  189                 | PROTECTED

  190 class_member_list: /* empty */
  191                  | class_member_list class_member

  192 class_member: declaration
  193             | function_definition
  194             | access_specifier ':'

  195 declarator: pointer direct_declarator
  196           | direct_declarator

  197 direct_declarator: IDENTIFIER
  198                  | '(' declarator ')'
  199                  | direct_declarator '[' constant_expression ']'
  200                  | direct_declarator '[' ']'
  201                  | direct_declarator '(' parameter_type_list ')'
  202                  | direct_declarator '(' ')'

  203 pointer: '*' type_qualifier_list_opt
  204        | pointer '*' type_qualifier_list_opt

  205 type_qualifier_list_opt: /* empty */
  206                        | type_qualifier_list

  207 type_qualifier_list: type_qualifier
  208                    | type_qualifier_list type_qualifier

  209 parameter_type_list: parameter_list
  210                    | parameter_list ',' ELLIPSIS

  211 parameter_list: parameter_declaration
  212               | parameter_list ',' parameter_declaration

  213 parameter_declaration: declaration_specifiers declarator
  214                      | declaration_specifiers abstract_declarator
  215                      | declaration_specifiers

  216 type_name: declaration_specifiers abstract_declarator
  217          | declaration_specifiers

  218 abstract_declarator: pointer
  219                    | pointer direct_abstract_declarator
  220                    | direct_abstract_declarator

  221 direct_abstract_declarator: '(' abstract_declarator ')'
  222                           | '[' ']'
  223                           | '[' constant_expression ']'
  224                           | direct_abstract_declarator '[' ']'
  225                           | direct_abstract_declarator '[' constant_expression ']'
  226                           | '(' ')'
  227                           | '(' parameter_type_list ')'
  228                           | direct_abstract_declarator '(' ')'
  229                           | direct_abstract_declarator '(' parameter_type_list ')'

  230 initializer: assignment_expression
  231            | '{' initializer_list '}'
  232            | '{' initializer_list ',' '}'

  233 initializer_list: initializer
  234                 | initializer_list ',' initializer



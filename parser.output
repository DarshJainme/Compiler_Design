Grammar

    0 $accept: program $end

    1 program: translation_unit

    2 translation_unit: external_declaration
    3                 | translation_unit external_declaration

    4 external_declaration: function_definition
    5                     | declaration
    6                     | expression_statement
    7                     | ';'

    8 function_definition: declaration_specifiers declarator compound_statement

    9 primary_expression: IDENTIFIER
   10                   | CONSTANT
   11                   | STRING_LITERAL
   12                   | CHAR_LITERAL
   13                   | BOOL_TRUE
   14                   | BOOL_FALSE
   15                   | '(' expression ')'
   16                   | lambda_expression

   17 postfix_expression: primary_expression
   18                   | postfix_expression '[' expression ']'
   19                   | postfix_expression '(' ')'
   20                   | postfix_expression '(' argument_expression_list ')'
   21                   | postfix_expression '.' IDENTIFIER
   22                   | postfix_expression PTR_OP IDENTIFIER
   23                   | postfix_expression INC_OP
   24                   | postfix_expression DEC_OP

   25 argument_expression_list: assignment_expression
   26                         | argument_expression_list ',' assignment_expression

   27 unary_expression: postfix_expression
   28                 | INC_OP unary_expression
   29                 | DEC_OP unary_expression
   30                 | '&' cast_expression
   31                 | '*' cast_expression
   32                 | '+' cast_expression
   33                 | '-' cast_expression
   34                 | '~' cast_expression
   35                 | '!' cast_expression
   36                 | SIZEOF unary_expression
   37                 | SIZEOF '(' type_name ')'
   38                 | new_expression
   39                 | delete_expression

   40 cast_expression: unary_expression
   41                | '(' type_name ')' cast_expression

   42 multiplicative_expression: cast_expression
   43                          | multiplicative_expression '*' cast_expression
   44                          | multiplicative_expression '/' cast_expression
   45                          | multiplicative_expression '%' cast_expression

   46 additive_expression: multiplicative_expression
   47                    | additive_expression '+' multiplicative_expression
   48                    | additive_expression '-' multiplicative_expression

   49 shift_expression: additive_expression
   50                 | shift_expression LSHIFT_OP additive_expression
   51                 | shift_expression RSHIFT_OP additive_expression

   52 relational_expression: shift_expression
   53                      | relational_expression '<' shift_expression
   54                      | relational_expression '>' shift_expression
   55                      | relational_expression LE_OP shift_expression
   56                      | relational_expression GE_OP shift_expression

   57 equality_expression: relational_expression
   58                    | equality_expression EQ_OP relational_expression
   59                    | equality_expression NE_OP relational_expression

   60 and_expression: equality_expression
   61               | and_expression '&' equality_expression

   62 exclusive_or_expression: and_expression
   63                        | exclusive_or_expression '^' and_expression

   64 inclusive_or_expression: exclusive_or_expression
   65                        | inclusive_or_expression '|' exclusive_or_expression

   66 logical_and_expression: inclusive_or_expression
   67                       | logical_and_expression LAND_OP inclusive_or_expression

   68 logical_or_expression: logical_and_expression
   69                      | logical_or_expression LOR_OP logical_and_expression

   70 conditional_expression: logical_or_expression
   71                       | logical_or_expression '?' expression ':' conditional_expression

   72 assignment_expression: conditional_expression
   73                      | unary_expression assignment_operator assignment_expression

   74 assignment_operator: '='
   75                    | MUL_ASSIGN
   76                    | DIV_ASSIGN
   77                    | MOD_ASSIGN
   78                    | ADD_ASSIGN
   79                    | SUB_ASSIGN
   80                    | LSHIFT_ASSIGN
   81                    | RSHIFT_ASSIGN
   82                    | AND_ASSIGN
   83                    | XOR_ASSIGN
   84                    | OR_ASSIGN

   85 expression: assignment_expression
   86           | expression ',' assignment_expression

   87 constant_expression: conditional_expression

   88 new_expression: NEW type_name '(' ')'
   89               | NEW type_name
   90               | NEW type_name initializer

   91 delete_expression: DELETE cast_expression

   92 lambda_expression: '[' ']' '(' ')' compound_statement

   93 statement: labeled_statement
   94          | compound_statement
   95          | expression_statement
   96          | selection_statement
   97          | iteration_statement
   98          | jump_statement

   99 labeled_statement: IDENTIFIER ':' statement
  100                  | CASE constant_expression ':' statement
  101                  | DEFAULT ':' statement

  102 compound_statement: '{' '}'
  103                   | '{' block_item_list '}'

  104 block_item_list: block_item
  105                | block_item_list block_item

  106 block_item: declaration
  107           | statement

  108 expression_statement: ';'
  109                     | expression ';'

  110 selection_statement: IF '(' expression ')' statement
  111                    | IF '(' expression ')' statement ELSE statement
  112                    | SWITCH '(' expression ')' statement

  113 iteration_statement: WHILE '(' expression ')' statement
  114                    | DO statement WHILE '(' expression ')' ';'
  115                    | FOR '(' expression_statement expression_statement ')' statement
  116                    | FOR '(' expression_statement expression_statement expression ')' statement
  117                    | FOR '(' declaration expression_statement ')' statement
  118                    | FOR '(' declaration expression_statement expression ')' statement

  119 jump_statement: GOTO IDENTIFIER ';'
  120               | CONTINUE ';'
  121               | BREAK ';'
  122               | RETURN ';'
  123               | RETURN expression ';'

  124 declaration: declaration_specifiers ';'
  125            | declaration_specifiers init_declarator_list ';'

  126 declaration_specifiers: declaration_specifier
  127                       | declaration_specifiers declaration_specifier

  128 declaration_specifier: storage_class_specifier
  129                      | type_specifier
  130                      | type_qualifier

  131 init_declarator_list: init_declarator
  132                     | init_declarator_list ',' init_declarator

  133 init_declarator: declarator
  134                | declarator '=' initializer

  135 storage_class_specifier: TYPEDEF
  136                        | EXTERN
  137                        | STATIC
  138                        | AUTO
  139                        | REGISTER

  140 type_specifier: VOID
  141               | CHAR
  142               | SHORT
  143               | INT
  144               | LONG
  145               | FLOAT
  146               | DOUBLE
  147               | SIGNED
  148               | UNSIGNED
  149               | BOOL
  150               | STRING
  151               | FILE_TYPE
  152               | struct_or_union_specifier
  153               | enum_specifier
  154               | class_specifier
  155               | TYPE_NAME

  156 type_qualifier: CONST
  157               | VOLATILE

  158 struct_or_union_specifier: STRUCT IDENTIFIER '{' struct_declaration_list '}'
  159                          | UNION IDENTIFIER '{' struct_declaration_list '}'
  160                          | STRUCT '{' struct_declaration_list '}'
  161                          | UNION '{' struct_declaration_list '}'
  162                          | STRUCT TYPE_NAME
  163                          | UNION TYPE_NAME

  164 struct_declaration_list: struct_declaration
  165                        | struct_declaration_list struct_declaration

  166 struct_declaration: declaration_specifiers struct_declarator_list ';'

  167 struct_declarator_list: struct_declarator
  168                       | struct_declarator_list ',' struct_declarator

  169 struct_declarator: declarator
  170                  | declarator ':' constant_expression

  171 enum_specifier: ENUM '{' enumerator_list '}'
  172               | ENUM IDENTIFIER '{' enumerator_list '}'
  173               | ENUM TYPE_NAME

  174 enumerator_list: enumerator
  175                | enumerator_list ',' enumerator

  176 enumerator: IDENTIFIER
  177           | IDENTIFIER '=' constant_expression

  178 class_specifier: CLASS class_name base_clause '{' class_member_list '}'

  179 class_name: IDENTIFIER

  180 base_clause: ε
  181            | ':' base_specifier
  182            | base_clause ',' base_specifier

  183 base_specifier: access_specifier class_name
  184               | class_name

  185 access_specifier: PUBLIC
  186                 | PRIVATE
  187                 | PROTECTED

  188 class_member_list: ε
  189                  | class_member_list class_member

  190 class_member: declaration
  191             | function_definition
  192             | access_specifier ':'

  193 declarator: pointer direct_declarator
  194           | direct_declarator

  195 direct_declarator: IDENTIFIER
  196                  | '(' declarator ')'
  197                  | direct_declarator '[' constant_expression ']'
  198                  | direct_declarator '[' ']'
  199                  | direct_declarator '(' parameter_type_list ')'
  200                  | direct_declarator '(' ')'

  201 pointer: '*' type_qualifier_list_opt
  202        | pointer '*' type_qualifier_list_opt

  203 type_qualifier_list_opt: ε
  204                        | type_qualifier_list

  205 type_qualifier_list: type_qualifier
  206                    | type_qualifier_list type_qualifier

  207 parameter_type_list: parameter_list
  208                    | parameter_list ',' ELLIPSIS

  209 parameter_list: parameter_declaration
  210               | parameter_list ',' parameter_declaration

  211 parameter_declaration: declaration_specifiers declarator
  212                      | declaration_specifiers abstract_declarator
  213                      | declaration_specifiers

  214 type_name: declaration_specifiers abstract_declarator
  215          | declaration_specifiers

  216 abstract_declarator: pointer
  217                    | pointer direct_abstract_declarator
  218                    | direct_abstract_declarator

  219 direct_abstract_declarator: '(' abstract_declarator ')'
  220                           | '[' ']'
  221                           | '[' constant_expression ']'
  222                           | direct_abstract_declarator '[' ']'
  223                           | direct_abstract_declarator '[' constant_expression ']'
  224                           | '(' ')'
  225                           | '(' parameter_type_list ')'
  226                           | direct_abstract_declarator '(' ')'
  227                           | direct_abstract_declarator '(' parameter_type_list ')'

  228 initializer: assignment_expression
  229            | '{' initializer_list '}'
  230            | '{' initializer_list ',' '}'

  231 initializer_list: initializer
  232                 | initializer_list ',' initializer



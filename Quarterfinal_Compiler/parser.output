Grammar

    0 $accept: translation_unit $end

    1 primary_expression: IDENTIFIER
    2                   | CONSTANT
    3                   | STRING_LITERAL
    4                   | CHAR_LITERAL
    5                   | BOOL_TRUE
    6                   | BOOL_FALSE
    7                   | '(' expression ')'
    8                   | lambda_expression

    9 postfix_expression: primary_expression
   10                   | postfix_expression '[' expression ']'
   11                   | postfix_expression '(' ')'
   12                   | postfix_expression '(' argument_expression_list ')'
   13                   | postfix_expression '.' IDENTIFIER
   14                   | postfix_expression PTR_OP IDENTIFIER
   15                   | postfix_expression INC_OP
   16                   | postfix_expression DEC_OP

   17 argument_expression_list: assignment_expression
   18                         | argument_expression_list ',' assignment_expression

   19 unary_expression: postfix_expression
   20                 | INC_OP unary_expression
   21                 | DEC_OP unary_expression
   22                 | unary_operator cast_expression
   23                 | SIZEOF unary_expression
   24                 | SIZEOF '(' type_name ')'

   25 unary_operator: '&'
   26               | '*'
   27               | '+'
   28               | '-'
   29               | '~'
   30               | '!'

   31 cast_expression: unary_expression
   32                | '(' type_name ')' cast_expression

   33 multiplicative_expression: cast_expression
   34                          | multiplicative_expression '*' cast_expression
   35                          | multiplicative_expression '/' cast_expression
   36                          | multiplicative_expression '%' cast_expression

   37 additive_expression: multiplicative_expression
   38                    | additive_expression '+' multiplicative_expression
   39                    | additive_expression '-' multiplicative_expression

   40 shift_expression: additive_expression
   41                 | shift_expression LSHIFT_OP additive_expression
   42                 | shift_expression RSHIFT_OP additive_expression

   43 relational_expression: shift_expression
   44                      | relational_expression '<' shift_expression
   45                      | relational_expression '>' shift_expression
   46                      | relational_expression LE_OP shift_expression
   47                      | relational_expression GE_OP shift_expression

   48 equality_expression: relational_expression
   49                    | equality_expression EQ_OP relational_expression
   50                    | equality_expression NE_OP relational_expression

   51 and_expression: equality_expression
   52               | and_expression '&' equality_expression

   53 exclusive_or_expression: and_expression
   54                        | exclusive_or_expression '^' and_expression

   55 inclusive_or_expression: exclusive_or_expression
   56                        | inclusive_or_expression '|' exclusive_or_expression

   57 logical_and_expression: inclusive_or_expression
   58                       | logical_and_expression LAND_OP inclusive_or_expression

   59 logical_or_expression: logical_and_expression
   60                      | logical_or_expression LOR_OP logical_and_expression

   61 conditional_expression: logical_or_expression
   62                       | logical_or_expression '?' expression ':' conditional_expression

   63 assignment_expression: conditional_expression
   64                      | unary_expression assignment_operator assignment_expression

   65 assignment_operator: '='
   66                    | MUL_ASSIGN
   67                    | DIV_ASSIGN
   68                    | MOD_ASSIGN
   69                    | ADD_ASSIGN
   70                    | SUB_ASSIGN
   71                    | LSHIFT_ASSIGN
   72                    | RSHIFT_ASSIGN
   73                    | AND_ASSIGN
   74                    | XOR_ASSIGN
   75                    | OR_ASSIGN

   76 expression: assignment_expression
   77           | expression ',' assignment_expression

   78 lambda_expression: lambda_introducer lambda_declarator_opt compound_statement

   79 lambda_introducer: '[' lambda_capture_opt ']'

   80 lambda_capture_opt: ε
   81                   | assignment_expression

   82 lambda_declarator_opt: ε
   83                      | '(' parameter_type_list ')' lambda_specifier_opt trailing_return_type_opt
   84                      | '(' ')' lambda_specifier_opt trailing_return_type_opt

   85 lambda_specifier_opt: ε
   86                     | STATIC

   87 trailing_return_type_opt: ε
   88                         | PTR_OP type_name

   89 constant_expression: conditional_expression

   90 declaration: declaration_specifiers ';'
   91            | declaration_specifiers init_declarator_list ';'

   92 declarator_id: class_name SCOPE_OP IDENTIFIER
   93              | IDENTIFIER

   94 declaration_specifiers: storage_class_specifier
   95                       | storage_class_specifier declaration_specifiers
   96                       | type_specifier
   97                       | type_specifier declaration_specifiers
   98                       | type_qualifier
   99                       | type_qualifier declaration_specifiers

  100 init_declarator_list: init_declarator
  101                     | init_declarator_list ',' init_declarator

  102 init_declarator: declarator
  103                | declarator '=' initializer

  104 storage_class_specifier: TYPEDEF
  105                        | EXTERN
  106                        | STATIC
  107                        | AUTO
  108                        | REGISTER

  109 type_specifier: VOID
  110               | STRING
  111               | CHAR
  112               | SHORT
  113               | INT
  114               | LONG
  115               | FLOAT
  116               | DOUBLE
  117               | SIGNED
  118               | UNSIGNED
  119               | BOOL
  120               | FILE_TYPE
  121               | struct_or_union_specifier
  122               | class_specifier
  123               | enum_specifier
  124               | TYPE_NAME

  125 struct_head: struct_or_union IDENTIFIER

  126 struct_or_union_specifier: struct_head '{' struct_declaration_list '}'
  127                          | struct_head
  128                          | struct_or_union '{' struct_declaration_list '}'

  129 struct_or_union: STRUCT
  130                | UNION

  131 struct_declaration_list: struct_declaration
  132                        | struct_declaration_list struct_declaration

  133 struct_declaration: specifier_qualifier_list struct_declarator_list ';'

  134 specifier_qualifier_list: type_specifier specifier_qualifier_list
  135                         | type_specifier
  136                         | type_qualifier specifier_qualifier_list
  137                         | type_qualifier

  138 struct_declarator_list: struct_declarator
  139                       | struct_declarator_list ',' struct_declarator

  140 struct_declarator: declarator
  141                  | declarator ':' constant_expression
  142                  | ':' constant_expression

  143 class_specifier: CLASS class_name '{' class_member_list '}'
  144                | CLASS class_name ':' base_class_list '{' class_member_list '}'

  145 base_class_list: access_specifier class_name
  146                | base_class_list ',' access_specifier class_name

  147 access_specifier: PUBLIC
  148                 | PRIVATE
  149                 | PROTECTED

  150 class_member_list: ε
  151                  | class_member_list class_member

  152 class_member: access_specifier ':'
  153             | declaration
  154             | function_definition

  155 class_name: IDENTIFIER

  156 enum_specifier: ENUM '{' enumerator_list '}'
  157               | ENUM IDENTIFIER '{' enumerator_list '}'

  158 enumerator_list: enumerator
  159                | enumerator_list ',' enumerator

  160 enumerator: IDENTIFIER
  161           | IDENTIFIER '=' constant_expression

  162 type_qualifier: CONST
  163               | VOLATILE

  164 declarator: pointer direct_declarator
  165           | direct_declarator

  166 direct_declarator: declarator_id
  167                  | '(' declarator ')'
  168                  | direct_declarator '[' constant_expression ']'
  169                  | direct_declarator '[' ']'
  170                  | direct_declarator '(' parameter_type_list ')'
  171                  | direct_declarator '(' identifier_list ')'
  172                  | direct_declarator '(' ')'

  173 pointer: '*'
  174        | '*' pointer

  175 parameter_type_list: parameter_list
  176                    | parameter_list ',' ELLIPSIS

  177 parameter_list: parameter_declaration
  178               | parameter_list ',' parameter_declaration

  179 parameter_declaration: declaration_specifiers declarator
  180                      | declaration_specifiers abstract_declarator
  181                      | declaration_specifiers

  182 identifier_list: IDENTIFIER
  183                | identifier_list ',' IDENTIFIER

  184 type_name: specifier_qualifier_list
  185          | specifier_qualifier_list abstract_declarator

  186 abstract_declarator: pointer
  187                    | direct_abstract_declarator
  188                    | pointer direct_abstract_declarator

  189 direct_abstract_declarator: '(' abstract_declarator ')'
  190                           | '[' ']'
  191                           | '[' constant_expression ']'
  192                           | direct_abstract_declarator '[' ']'
  193                           | direct_abstract_declarator '[' constant_expression ']'

  194 initializer: assignment_expression
  195            | '{' initializer_list '}'
  196            | '{' initializer_list ',' '}'

  197 initializer_list: initializer
  198                 | initializer_list ',' initializer

  199 statement: labeled_statement
  200          | compound_statement
  201          | expression_statement
  202          | selection_statement
  203          | iteration_statement
  204          | jump_statement

  205 labeled_statement: IDENTIFIER ':' statement
  206                  | CASE constant_expression ':' statement
  207                  | DEFAULT ':' statement

  208 compound_statement: '{' '}'
  209                   | '{' block_items '}'

  210 block_items: block_item
  211            | block_items block_item
  212            | error

  213 block_item: declaration
  214           | statement

  215 expression_statement: ';'
  216                     | expression ';'

  217 selection_statement: IF '(' expression ')' statement
  218                    | IF '(' expression ')' statement ELSE statement
  219                    | SWITCH '(' expression ')' statement

  220 iteration_statement: WHILE '(' expression ')' statement
  221                    | UNTIL '(' expression ')' statement
  222                    | DO statement WHILE '(' expression ')' ';'
  223                    | FOR '(' expression_statement expression_statement ')' statement
  224                    | FOR '(' expression_statement expression_statement expression ')' statement
  225                    | FOR '(' declaration expression_statement ')' statement
  226                    | FOR '(' declaration expression_statement expression ')' statement

  227 jump_statement: GOTO IDENTIFIER ';'
  228               | CONTINUE ';'
  229               | BREAK ';'
  230               | RETURN ';'
  231               | RETURN expression ';'

  232 translation_unit: external_declaration
  233                 | translation_unit external_declaration

  234 external_declaration: function_definition
  235                     | declaration
  236                     | statement
  237                     | error

  238 function_definition: declaration_specifiers declarator compound_statement


